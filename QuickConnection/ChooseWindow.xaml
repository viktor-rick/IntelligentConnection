<Window x:Class="QuickConnection.ChooseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuickConnection" 
        mc:Ignorable="d"
        Title="ChooseWindow">
    
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ResizeMode" Value="CanResize" />
            <Setter Property="AllowsTransparency" Value="True" />
            <Setter Property="WindowChrome.WindowChrome">
                <Setter.Value>
                    <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Style>

    <Window.Resources>

        <local:BitmapConverter x:Key="BitmapConverter"/>

        <Style TargetType="ListBox" x:Key="BoxStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>

            <!-- DEFAULT VIEW: GRID (WRAPPANEL + ICONS ONLY) -->
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Image Source="{Binding Icon, Converter={StaticResource BitmapConverter}}"
                           Width="24" Height="24"
                           Margin="1,1,1,1"
                           ToolTip="{Binding InitString}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>

            <!-- LIST VIEW (Triggered when ViewModeToggle.IsChecked == True) -->
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=ViewModeToggle}" Value="True">

                    <!-- Switch layout to vertical list -->
                    <Setter Property="ItemsPanel">
                        <Setter.Value>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </Setter.Value>
                    </Setter>

                    <!-- Show icon + text instead of just icons -->
                    <Setter Property="ItemTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <DockPanel Margin="1,0,1,0">
                                    <Image Source="{Binding Icon, Converter={StaticResource BitmapConverter}}"
                                       Width="24" Height="24"
                                       Margin="0,0,5,0"
                                       DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding InitString}"
                                       VerticalAlignment="Center"
                                       FontStyle="Italic"
                                       Foreground="#444"/>          
                                </DockPanel>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>

                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Apply BoxStyle to all ListBoxes by default -->
        <Style TargetType="ListBox" BasedOn="{StaticResource BoxStyle}"/>

    </Window.Resources>

    <DockPanel>

        <!-- 🔽 Bottom Panel (toggle + inputs) -->
        <Border DockPanel.Dock="Bottom"
        BorderBrush="#DDD"
        BorderThickness="1"
        Padding="5"
        Background="#F8F8F8">

            <StackPanel Orientation="Vertical" Margin="5">

                <!-- Toggle + Label -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <ToggleButton x:Name="ViewModeToggle"
                          Width="40"
                          Height="20">

                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid>
                                                <Border x:Name="Track"
                                                Background="#ccc"
                                                CornerRadius="10"/>
                                                <Ellipse x:Name="Thumb"
                                                 Width="14" Height="14"
                                                 Fill="White"
                                                 Margin="3"
                                                 HorizontalAlignment="Left"/>
                                            </Grid>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Track" Property="Background" Value="#4CAF50"/>
                                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <TextBlock Text="List"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Margin="6,0,0,0"/>
                </StackPanel>

                <!-- A input -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Trace:"
                       Width="40"
                       VerticalAlignment="Center"/>
                    <TextBox x:Name="IntA"
                     Width="50"/>
                </StackPanel>

                <!-- B input -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Predict:"
                       Width="50"
                       VerticalAlignment="Center"/>
                    <TextBox x:Name="IntB"
                     Width="40"/>
                </StackPanel>

                <Button Content="Update"
                        Width="70"
                        Margin="0,6,0,0"
                        Click="OnTracePredictUpdated"/>

            </StackPanel>
        </Border>

        <!-- TOP: Tabs -->
        <TabControl>
            <TabItem x:Name="BrainTitle">
                <ListBox x:Name="BrainList" SelectionChanged="SelectionChanged"/>
            </TabItem>

            <TabItem x:Name="ObjectTitle">
                <ListBox x:Name="ObjectList" SelectionChanged="SelectionChanged"/>
            </TabItem>

            <TabItem x:Name="CurveTitle">
                <ListBox x:Name="CurveList" SelectionChanged="SelectionChanged"/>
            </TabItem>

            <TabItem x:Name="BrepTitle">
                <ListBox x:Name="BrepList" SelectionChanged="SelectionChanged"/>
            </TabItem>

            <TabItem x:Name="GeoTitle">
                <ListBox x:Name="GeoList" SelectionChanged="SelectionChanged"/>
            </TabItem>

            <TabItem x:Name="GeneralTitle">
                <ListBox x:Name="GeneralList" SelectionChanged="SelectionChanged"/>
            </TabItem>

            <TabItem x:Name="ListTitle">
                <ListBox x:Name="ListList" SelectionChanged="SelectionChanged"/>
            </TabItem>

            <TabItem x:Name="TreeTitle">
                <ListBox x:Name="TreeList" SelectionChanged="SelectionChanged"/>
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
